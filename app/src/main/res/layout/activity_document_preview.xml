<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#334155">

    <!-- Top App Bar / Document Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarDocPreview"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnBackDoc"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDocPreviewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Official_Document.pdf"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDocPreviewSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official Institutional Document Preview"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnOpenExternalTop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open in External App"
                android:src="@drawable/ic_share"
                app:tint="@color/on_surface" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Document Controls Bar: Page Navigation & Zoom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/surface_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_attachment_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Page 1 of 2"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevPage"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Previous Page"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="18dp"
                app:iconTint="@color/on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextPage"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Next Page"
                app:icon="@drawable/ic_share"
                app:iconSize="18dp"
                app:iconTint="@color/on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadDocTop"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="Download"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_pdf"
                app:iconSize="14dp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Multi-Page Continuous PDF RecyclerView (Renders all pages smoothly) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPdfPages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Centered Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbLoadingPdf"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Scrollable Fallback & Office Document Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollFallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        android:visibility="visible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Office Document Inspection Card (for DOCX, DOC, etc.) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutOfficeDocContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/ic_attach_file"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvOfficeDocName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Document_Name.docx"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOfficeDocMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Microsoft Word Document • Verified Release"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenOfficeApp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:text="Open in Word / Docs App"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_share" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fallback Letterhead Paper (Used when no physical document binary exists) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDocumentPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="8dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- University Official Letterhead Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏛️"
                        android:textSize="36sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:letterSpacing="0.04"
                        android:text="METROPOLITAN UNIVERSITY OF TECHNOLOGY"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="OFFICE OF THE REGISTRAR &amp; CONTROLLER OF EXAMINATIONS"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDocRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ref: MUT/PUB/2026/0491 • Authenticated Institutional Release"
                        android:textColor="#475569"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Color Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginVertical="16dp"
                    android:background="#4F46E5" />

                <!-- Document Directive Title -->
                <TextView
                    android:id="@+id/tvDocHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="OFFICIAL NOTICE &amp; DIRECTIVE"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Notice Content Paragraph -->
                <TextView
                    android:id="@+id/tvDocNoticeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="Full official notice content and institutional guidelines..."
                    android:textColor="#334155"
                    android:textSize="13sp" />

                <!-- Official Table Layout Container -->
                <LinearLayout
                    android:id="@+id/layoutDocTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTableTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFFICIAL TIMETABLE &amp; SCHEDULE SPECIFICATION"
                        android:textColor="#1E293B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#CBD5E1" />

                    <TextView
                        android:id="@+id/tvTableDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• CSE 420: Distributed Systems | April 05, 2026 | 09:30 AM | Auditorium 2\n• CSE 312: Operating Systems | April 08, 2026 | 01:30 PM | Computer Lab 4\n• CSE 211: Data Structures | April 12, 2026 | 09:30 AM | Hall 304"
                        android:textColor="#334155"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Official Verification Stamp -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_urgent_badge"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ VERIFIED INSTITUTIONAL DOCUMENT ★"
                        android:textColor="@color/badge_urgent"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Signee Block -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDocSignee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dr. Robert Vance"
                        android:textColor="#1E40AF"
                        android:textSize="14sp"
                        android:textStyle="italic|bold" />

                    <View
                        android:layout_width="140dp"
                        android:layout_height="1dp"
                        android:layout_marginVertical="3dp"
                        android:background="#94A3B8" />

                    <TextView
                        android:id="@+id/tvDocDesignation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Office of the Registrar"
                        android:textColor="#64748B"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
