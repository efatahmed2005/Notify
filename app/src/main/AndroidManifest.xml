<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Notifyy"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notify"
        tools:targetApi="31">

        <!-- Main Launcher & Role Selector -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 4-Tier Role Dashboards -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.deptadmin.DeptAdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.teacher.TeacherDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.StudentFeedActivity"
            android:exported="false" />

        <!-- Notice Operations & Details -->
        <activity
            android:name=".ui.teacher.CreateNoticeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.details.NoticeDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.details.DocumentPreviewActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- Legacy Activity Compatibility Entries -->
        <activity
            android:name=".TeacherActivity"
            android:exported="false" />
        <activity
            android:name=".StudentActivity"
            android:exported="false" />
        <activity
            android:name=".CreateNotificationActivity"
            android:exported="false" />
        <activity
            android:name=".activity_details"
            android:exported="false" />
        <!-- FileProvider for secure PDF and document viewing/sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>