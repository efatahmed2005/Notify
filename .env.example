# Copy to .env. Never commit actual credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://localhost:8080
DATABASE_PATH=./var/notify.sqlite
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Opt-in development only. Students MUST exist in the admin-managed directory.
ALLOW_PROVISIONAL_STUDENTS=false
# Production requires HTTPS, SMTP, and an institution-approved MFA access gateway for admin.
ADMIN_MFA_GATEWAY_CONFIRMED=false
# Initial setup / operator recovery only; remove these variables after use.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# SMTP is used for student email verification and password reset links.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
